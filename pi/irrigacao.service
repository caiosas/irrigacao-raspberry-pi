[Unit]
Description=Irrigacao - sensores, bomba e MQTT
After=mosquitto.service network-online.target
Wants=mosquitto.service

[Service]
User=pi
WorkingDirectory=/home/pi/irrigacao
ExecStart=/usr/bin/python3 -u /home/pi/irrigacao/irrigacao.py
Environment=GPIOZERO_PIN_FACTORY=lgpio
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
